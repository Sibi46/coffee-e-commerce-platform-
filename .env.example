# Set in your terminal or hosting dashboard. Django does not auto-load this file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# Optional PostgreSQL configuration (install requirements-production.txt).
# DB_ENGINE=postgresql
# DB_NAME=kedarmart
# DB_USER=kedarmart
# DB_PASSWORD=replace-me
# DB_HOST=localhost
# DB_PORT=5432
# Vercel: persistent PostgreSQL connection URL (keep private).
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional custom-domain CSRF origins, comma-separated HTTPS origins.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Persistent category images: S3-compatible storage, such as Cloudflare R2.
# MEDIA_S3_BUCKET=your-bucket
# MEDIA_S3_ACCESS_KEY=your-storage-access-key
# MEDIA_S3_SECRET_KEY=your-storage-secret-key
# MEDIA_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# Initial Super Admin is created once from private environment settings.
# INITIAL_ADMIN_USERNAME=your-admin-username
# INITIAL_ADMIN_PASSWORD=your-admin-password
# INITIAL_ADMIN_EMAIL=your-admin-email
